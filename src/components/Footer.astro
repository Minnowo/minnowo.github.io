---
import { SITE, FOOTER } from '../site.config';
---

<footer class="flex flex-wrap items-center justify-center gap-4">
    {FOOTER.showSourceCode && <small><a href={SITE.sourceCode}>Source Code</a></small>}
    {FOOTER.showRssUrl && <small><a href="/feed.xml">RSS Feed</a></small>}
    {FOOTER.showLicenseUrl && <small><a href="/LICENSE">License</a></small>}
    {FOOTER.showAppleWorm && (
        <small><a class="text-transparent hover:text-c-primary" href="/assets/AppleWorm/">Apple Worm</a></small>
    )}
</footer>
