---
export interface Props {
  date: Date;
  tags: string[];
}

const { date, tags } = Astro.props;

const isoDate = date.toISOString().slice(0, 10);
const displayDate = date.toLocaleDateString('en-US', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<div class="mb-5 flex flex-wrap items-center justify-between gap-2 border-t border-b border-dashed border-c-surface1 py-2">
    <div class="text-[0.9em] text-c-subtext0">
        <time datetime={isoDate}>{displayDate}</time>
    </div>
    <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
        {tags.map((tag) => (
            <li><a class="inline-block rounded text-[0.8em] text-c-base! bg-c-peach px-1.5 py-px hover:bg-c-flamingo hover:no-underline" href={`/tag/${tag}/`}>{tag}</a></li>
        ))}
    </ul>
</div>
