---
import IconTag from './IconTag.astro';
import { getVisiblePosts, postUrl } from '../lib/posts';

const allPosts = await getVisiblePosts();
const recentPosts = allPosts.slice(0, 5);

const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const sortedTags = [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<div class="sidebar">
  <h2>Recent Posts</h2>
  <ul>
    {recentPosts.map((post) => (
      <li><a href={postUrl(post.id)}>{post.data.title}</a></li>
    ))}
  </ul>
</div>

<div class="sidebar">
  <h2>Tags</h2>
  <ul class="fa-ul">
    {sortedTags.map(([tag, count]) => (
      <li>
        <IconTag />
        <a href={`/tag/${tag}/`} data-toggle="tooltip" data-placement="right" title={String(count)}>
          <span>{tag}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
