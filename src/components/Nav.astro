---
import { SITE, NAV } from '../site.config';
---

<nav class="navbar">
    <div class="navbar-collapse">
        <a class="navbar-brand" href="/">
            <img src="/favicon.png" alt="">
            {SITE.name}
        </a>

        <div class="navbar-nav">
            {NAV.map((item) => (
                <a class="nav-link link-fade" href={item.href}>{item.label}</a>
            ))}
        </div>
    </div>
</nav>
