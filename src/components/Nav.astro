---
import { SITE, NAV } from '../site.config';
---

<nav class="surface-1 mx-auto mt-4 flex w-full max-w-200 flex-wrap items-center justify-between gap-2 rounded-none sm:rounded-md">
    <a class="text-c-on-surface" href="/">
        <strong>{SITE.name}</strong>
    </a>

    <div class="flex flex-wrap items-center gap-2">
        {NAV.map((item) => (
            <a href={item.href}>{item.label}</a>
        ))}
    </div>
</nav>
