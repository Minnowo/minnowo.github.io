---
import Shell from './Shell.astro';
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Heading } from '../types';

export interface Props {
  title: string;
  url: string;
  date: Date;
  tags: string[];
  toc?: boolean;
  headings?: Heading[];
}

const { title, url, date, tags, toc, headings } = Astro.props;
---

<Shell title={title}>
    <div class="rounded-[10px] border border-c-surface1 bg-c-surface0 p-5">
        <h1>
            <a href={url} class="text-c-peach hover:text-c-flamingo hover:underline">{title}</a>
        </h1>
        <PostMeta date={date} tags={tags} />
        <div class="post-content prose">
            {toc && <TableOfContents headings={headings} />}
            <slot />
        </div>
    </div>
</Shell>
