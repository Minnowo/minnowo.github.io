---
import PageLayout from '../layouts/PageLayout.astro';
import { SITES } from '../site.config';
---

<PageLayout title="Sites">
    <h1>Sites</h1>
    <div class="flex flex-col gap-2">
        {SITES.map((site) => (
            <div class="surface-2 flex flex-col gap-1">
                <h4><a href={site.href}>{site.name}</a></h4>
                <p>{site.description}</p>
            </div>
        ))}
    </div>
</PageLayout>
