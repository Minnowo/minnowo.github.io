---
import PageLayout from '../layouts/PageLayout.astro';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---

<PageLayout title="Tags">
    <h1 class="mb-2 border-b border-c-surface1 pb-2 text-[1.8em] font-bold">Tags</h1>
    <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
        {tags.map((tag) => (
            <li><a class="inline-block rounded text-[0.8em] text-c-base! bg-c-peach px-1.5 py-px hover:bg-c-flamingo hover:no-underline" href={`/tag/${tag}/`}>{tag}</a></li>
        ))}
    </ul>
</PageLayout>
