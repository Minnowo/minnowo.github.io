---
import PageLayout from '../layouts/PageLayout.astro';
import { getVisiblePosts, postUrl } from '../lib/posts';

const posts = (await getVisiblePosts()).slice(0, 10);
---

<PageLayout>
    <div class="flex flex-col gap-2">
        {posts.map((post) => (
            <div class="surface-2 flex flex-col gap-2">
                <div>
                    <h2><a href={postUrl(post.id)}>{post.data.title}</a></h2>
                    <small><time>{post.data.date.toISOString().slice(0, 10)}</time></small>
                </div>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                    <ul class="flex list-none flex-wrap gap-2">
                        {post.data.tags.map((tag) => (
                            <li><a class="btn-outlined-primary" href={`/tag/${tag}/`}>{tag}</a></li>
                        ))}
                    </ul>
                )}
            </div>
        ))}
    </div>

    <h3 class="text-center"><a href="/archive/">Archive</a></h3>
</PageLayout>
