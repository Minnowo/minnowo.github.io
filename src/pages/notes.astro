---
import PageLayout from '../layouts/PageLayout.astro';
import { getVisiblePosts, postUrl } from '../lib/posts';

const posts = (await getVisiblePosts()).filter((post) => post.data.tags.includes('note'));
---

<PageLayout title="Notes">
    <div class="page-content wc-container">
        <div class="post">
            <h1>Notes</h1>
            <ul>
                {posts.map((post) => (
                    <li>
                        <div class="post-time">
                            <time>{post.data.date.toISOString().slice(0, 10)}</time>
                            <a href={postUrl(post.id)}>{post.data.title}</a>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</PageLayout>
