---
import PageLayout from '../layouts/PageLayout.astro';
import { getVisiblePosts, postUrl } from '../lib/posts';

const posts = (await getVisiblePosts()).filter((post) => post.data.tags.includes('note'));
---

<PageLayout title="Notes">
    <h1>Notes</h1>
    <ul class="flex list-none flex-col gap-2">
        {posts.map((post) => (
            <li class="flex flex-wrap items-baseline gap-2">
                <small><time>{post.data.date.toISOString().slice(0, 10)}</time></small>
                <a href={postUrl(post.id)}>{post.data.title}</a>
            </li>
        ))}
    </ul>
</PageLayout>
