---
import PageLayout from '../layouts/PageLayout.astro';
import { getVisiblePosts, postUrl } from '../lib/posts';

const posts = await getVisiblePosts();

const byYear = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.date.getFullYear());
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => Number(b) - Number(a));
---

<PageLayout title="Blog archive">
    <h1 class="border-b border-c-surface1 pb-2">Blog Archive</h1>
    {years.map((year) => (
        <>
            <h5 class="mt-6 text-c-maroon">{year}</h5>
            <ul class="m-0 mb-4 list-none p-0">
                {byYear.get(year)!.map((post) => (
                    <li class="border-b border-dashed border-c-surface0 py-1.5">
                        <a class="text-c-peach hover:text-c-flamingo hover:underline" href={postUrl(post.id)}>{post.data.title}</a>
                    </li>
                ))}
            </ul>
        </>
    ))}
</PageLayout>
