---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allLinks = (await getCollection('links', ({ data }) => !data.hidden))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function firstLetter(title: string) {
  return title.trim().slice(0, 1).toUpperCase();
}

const letters = [...new Set(allLinks.map((link) => firstLetter(link.data.title)))];
---

<PageLayout title="Links">
    <ul class="m-0 mb-4 flex list-none flex-wrap gap-x-3 p-0">
        {letters.map((letter) => (
            <li>
                <a class="text-c-peach hover:text-c-flamingo" href={`#${letter}`}>{letter}</a>
            </li>
        ))}
    </ul>

    {letters.map((letter) => (
        <>
            <h4 id={letter} class="mt-6 mb-2 text-[1.05em] font-bold text-c-maroon">[{letter}]</h4>

            <ul class="m-0 mb-4 list-none divide-y divide-dashed divide-c-surface0 p-0">
                {allLinks.filter((link) => firstLetter(link.data.title) === letter).map((link) => {
                    const slug = link.data.title
                      .toLowerCase()
                      .trim()
                      .replace(/[^a-z0-9]+/g, '-')
                      .replace(/^-+|-+$/g, '');
                    return (
                        <li class="py-3 first:pt-0 last:pb-0">
                            <h2 id={slug} class="mb-1 text-[1.05em] font-bold">
                                <a class="mr-1 text-c-overlay1 hover:text-c-flamingo" href={`#${slug}`}>#</a>
                                {link.data.title}
                            </h2>

                            <p class="mb-2 text-c-subtext1">{link.data.description}</p>

                            <ul class="m-0 list-none p-0">
                                {link.data.urls.map((url, i) => (
                                    <li class="py-0.5 text-[0.85em]">
                                        <strong class="mr-1 text-c-peach">{link.data.url_prefix[i]}</strong>
                                        <a class="inline-block max-w-full truncate align-bottom text-c-text hover:text-c-flamingo" href={url} target="_blank" rel="noopener noreferrer">{url}</a>

                                        {link.data.desc[i] && (
                                            <p class="text-c-subtext0">{link.data.desc[i]}</p>
                                        )}
                                    </li>
                                ))}
                            </ul>
                        </li>
                    );
                })}
            </ul>
        </>
    ))}
</PageLayout>
