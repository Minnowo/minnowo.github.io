---
import PageLayout from '../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const allLinks = (await getCollection('links', ({ data }) => !data.hidden))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

function firstLetter(title: string) {
  return title.trim().slice(0, 1).toUpperCase();
}

const letters = [...new Set(allLinks.map((link) => firstLetter(link.data.title)))];
---

<PageLayout title="Links">
    <ul class="flex list-none flex-wrap gap-2">
        {letters.map((letter) => (
            <li><a href={`#${letter}`}>{letter}</a></li>
        ))}
    </ul>

    {letters.map((letter) => (
        <div class="flex flex-col gap-2">
            <h3 id={letter}>[{letter}]</h3>

            {allLinks.filter((link) => firstLetter(link.data.title) === letter).map((link) => {
                const slug = link.data.title
                  .toLowerCase()
                  .trim()
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-+|-+$/g, '');
                return (
                    <div class="surface-2 flex flex-col gap-2">
                        <div>
                            <h4 id={slug}><a href={`#${slug}`}>#</a> {link.data.title}</h4>
                            <small>{link.data.description}</small>
                        </div>

                        <ul class="flex list-none flex-col gap-2">
                            {link.data.urls.map((url, i) => (
                                <li class="flex flex-col">
                                    <span class="min-w-0">
                                        <strong>{link.data.url_prefix[i]}</strong>{' '}
                                        <a class="inline-block max-w-full truncate align-bottom" href={url} target="_blank" rel="noopener noreferrer">{url}</a>
                                    </span>
                                    {link.data.desc[i] && <small>{link.data.desc[i]}</small>}
                                </li>
                            ))}
                        </ul>
                    </div>
                );
            })}
        </div>
    ))}
</PageLayout>
